  "eloha": "(?<![א-ת])ו?(?:(?:כש|ש)(?=[בלמכה]))?[בלמכ]?ה?א[֑-ׇ]*ל[֑-ׇ]*(?:ו)?[֑-ׇ]*ה[֑-ׇ]*(?:ות|ית|יות)?(?![א-ת])",
  "adnut": "(?<![א-ת])ו?(?:(?:כש|ש)(?=[בלמכה]))?[בלמכ]?ה?א[֑-ׇ]*ד[֑-ׇ]*נ[֑-ׇ]*י(?![א-ת])",
  "tsvaot": "(?<![א-ת])ו?(?:(?:כש|ש)(?=[בלמכה]))?[בלמכ]?ה?צ[֑-ׇ]*ב[֑-ׇ]*א[֑-ׇ]*(?:ו)?[֑-ׇ]*ת(?![א-ת])",
  "ehye": "(?<![א-ת])ו?(?:(?:כש|ש)(?=[בלמכה]))?[בלמכ]?ה?א[֑-ׇ]*ה[֑-ׇ]*י[֑-ׇ]*ה(?![א-ת])",
  "shaday": "(?<![א-ת])ו?(?:(?:כש|ש)(?=[בלמכה]))?[בלמכ]?ה?ש[֑-ׇ]*ד[֑-ׇ]*י(?![א-ת])",
  "el": "(?<![א-ת])ו?(?:(?:כש|ש)(?=[בלמכה]))?[בלמכ]?ה?א[֑-ׇ]*ל[֑-ׇ]*(?:י)?(?![א-ת])"
