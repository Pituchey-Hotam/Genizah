<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="Genizah.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="Genizah.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <applicationSettings>
        <Genizah.Properties.Settings>
            <!-- The classifier's decision thresholds, in logits (the model's raw output). A name
                 is censored at or above censor_logit_threshold, left below
                 leave_logit_threshold, and asked about in between. They belong to the shipping
                 model's fit (classifier phase 4). Until both are set, every name is asked about. -->
            <setting name="censor_logit_threshold" serializeAs="String">
                <value />
            </setting>
            <setting name="leave_logit_threshold" serializeAs="String">
                <value />
            </setting>
        </Genizah.Properties.Settings>
    </applicationSettings>
    <userSettings>
        <Genizah.Properties.Settings>
            <setting name="name_replacement_havaya" serializeAs="String">
                <value />
            </setting>
            <setting name="name_replacement_adnut" serializeAs="String">
                <value />
            </setting>
            <setting name="name_replacement_el" serializeAs="String">
                <value />
            </setting>
            <setting name="name_replacement_eloha" serializeAs="String">
                <value />
            </setting>
            <setting name="name_replacement_elohim" serializeAs="String">
                <value />
            </setting>
            <setting name="name_replacement_ehye" serializeAs="String">
                <value />
            </setting>
            <setting name="name_replacement_shaday" serializeAs="String">
                <value />
            </setting>
            <setting name="name_replacement_tsvaot" serializeAs="String">
                <value />
            </setting>
        </Genizah.Properties.Settings>
    </userSettings>
</configuration>