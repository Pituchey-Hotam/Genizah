<UserControl x:Class="Genizah.Results.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Genizah.Results"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI" FontSize="12"
             TextOptions.TextFormattingMode="Display"
             PreviewTextInput="View_PreviewTextInput"
             IsKeyboardFocusWithinChanged="View_FocusChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Genizah;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Review status colors appear only in the sidebar. -->
            <SolidColorBrush x:Key="PendingMark" Color="#F2C811"/>
            <SolidColorBrush x:Key="CensoredMark" Color="#3CB043"/>
            <SolidColorBrush x:Key="LeftMark" Color="#A19F9D"/>
            <BooleanToVisibilityConverter x:Key="Visible"/>
            <Style x:Key="ShortcutKey" TargetType="Border">
                <Setter Property="MinWidth" Value="14"/>
                <Setter Property="Height" Value="15"/>
                <Setter Property="Padding" Value="1,0"/>
                <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="TextElement.FontSize" Value="11"/>
            </Style>

            <Style x:Key="Row" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="border" Background="Transparent" Padding="8,0">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Hover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Selected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate DataType="{x:Type local:GroupHeader}">
                <Grid Height="30" Background="Transparent" MouseLeftButtonUp="Header_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <!-- Points forward when collapsed (mirrored in right-to-left), down when expanded. -->
                    <Path x:Name="chevron" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource SecondaryText}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter TargetName="chevron" Property="RenderTransform">
                            <Setter.Value>
                                <RotateTransform Angle="90"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:ResultItem}">
                <Grid x:Name="resultRow" Height="26" ToolTip="{Binding StatusText}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="mark" Grid.Column="1" Width="8" Height="8" Fill="{StaticResource PendingMark}"
                             VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="snippet" Grid.Column="2" VerticalAlignment="Center" TextTrimming="WordEllipsis">
                        <Run Text="{Binding SnippetBefore, Mode=OneWay}"/><Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold"/><Run Text="{Binding SnippetAfter, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Censored">
                        <Setter TargetName="mark" Property="Fill" Value="{StaticResource CensoredMark}"/>
                        <Setter TargetName="snippet" Property="Foreground" Value="{StaticResource SecondaryText}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Left">
                        <Setter TargetName="mark" Property="Fill" Value="{StaticResource LeftMark}"/>
                        <Setter TargetName="snippet" Property="Foreground" Value="{StaticResource SecondaryText}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStale}" Value="True">
                        <Setter TargetName="mark" Property="Fill" Value="{StaticResource LeftMark}"/>
                        <Setter TargetName="resultRow" Property="Opacity" Value="0.5"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource Surface}" TextElement.Foreground="{StaticResource Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="reviewHeader" Margin="12,10,12,8">
            <Border x:Name="summaryCounts" Visibility="Collapsed" Background="{StaticResource Hover}"
                    CornerRadius="4" Padding="10,7" Margin="0,0,0,6">
                <ItemsControl x:Name="summaryLines">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="6" Height="6" Fill="{StaticResource PendingMark}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="{Binding Pending, Converter={StaticResource Visible}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                           Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="SemiBold"
                                           FlowDirection="LeftToRight" TextAlignment="Left"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock x:Name="summary" TextWrapping="Wrap"/>
            <TextBlock x:Name="summaryNotice" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryText}" Visibility="Collapsed"/>
        </StackPanel>

        <!-- A scan's progress: its stage, a bar (moving while the stage has no count), and the count. -->
        <StackPanel x:Name="progressPanel" Margin="12,10,12,8" Visibility="Collapsed">
            <TextBlock x:Name="progressStage" TextWrapping="Wrap"/>
            <ProgressBar x:Name="progressBar" Height="4" Margin="0,8,0,6" BorderThickness="0"
                         Foreground="{StaticResource Accent}" Background="{StaticResource Divider}"/>
            <TextBlock x:Name="progressCount" Foreground="{StaticResource SecondaryText}"/>
        </StackPanel>

        <ListBox x:Name="list" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 ItemContainerStyle="{StaticResource Row}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 SelectionMode="Single"
                 IsTextSearchEnabled="False"
                 SelectionChanged="List_SelectionChanged"
                 KeyDown="List_KeyDown"/>

        <Border x:Name="details" Grid.Row="2" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0"
                Padding="12,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8">
                    <Run Text="{Binding ContextBefore, Mode=OneWay}"/><Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold"/><Run Text="{Binding ContextAfter, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                <TextBlock ToolTip="{Binding ScoreText}" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryText}">
                    <Run Text="{Binding VerdictText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding ReplacementText}" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="צנזר" Style="{StaticResource PrimaryButton}" Click="Censor_Click"
                            ToolTip="צנזר (צ)"
                            Visibility="{Binding CanCensor, Converter={StaticResource Visible}}"/>
                    <Button Content="השאר" Style="{StaticResource FlatButton}" Click="Leave_Click"
                            ToolTip="אין זה שם קודש: להשאיר כפי שנכתב (ה)"
                            Visibility="{Binding CanLeave, Converter={StaticResource Visible}}"/>
                    <Button Content="בטל צנזור" Style="{StaticResource FlatButton}" Click="Leave_Click"
                            ToolTip="בטל צנזור (ה)"
                            Visibility="{Binding CanUndo, Converter={StaticResource Visible}}"/>
                </StackPanel>
                <TextBlock Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,8,0,0"
                           TextWrapping="Wrap">
                    <InlineUIContainer BaselineAlignment="Center"><Border Style="{StaticResource ShortcutKey}"><TextBlock Text="↑↓" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></InlineUIContainer>
                    <Run Text=" מעבר · "/>
                    <InlineUIContainer BaselineAlignment="Center"><Border Style="{StaticResource ShortcutKey}"><TextBlock Text="צ" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></InlineUIContainer>
                    <Run Text=" צנזור · "/>
                    <InlineUIContainer BaselineAlignment="Center"><Border Style="{StaticResource ShortcutKey}"><TextBlock Text="ה" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></InlineUIContainer>
                    <Run Text=" השארה או ביטול צנזור"/>
                </TextBlock>
            </StackPanel>
        </Border>
        <!-- The rescan action, and in the rest of its row the offer to share the review's decisions
             (Contributing): a link, or how sharing went. -->
        <Border x:Name="scanFooter" Grid.Row="3" BorderBrush="{StaticResource Divider}"
                BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="scanButton" Grid.Column="1" Content="סרוק שוב" Style="{StaticResource FlatButton}"
                        Margin="8,0,0,0" VerticalAlignment="Center" Click="Scan_Click"
                        ToolTip="סרוק את המסמך מחדש"/>
                <TextBlock x:Name="contributeSlot" VerticalAlignment="Center" TextWrapping="Wrap" IsVisibleChanged="ContributionSlot_IsVisibleChanged"
                           Margin="4,2,0,2" Visibility="Collapsed" ToolTipService.ShowDuration="20000">
                    <Hyperlink x:Name="contributeLink" Click="ContributeLink_Click"
                               ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="20000"
                               Foreground="{StaticResource Accent}"><Run x:Name="contributeLinkText"/></Hyperlink><Run
                        x:Name="contributeStatus" Foreground="{StaticResource SecondaryText}"/><InlineUIContainer BaselineAlignment="Center"><TextBlock x:Name="contributePreview" Visibility="Collapsed"><Run Text=" · "/><Hyperlink Click="ContributeShow_Click" Foreground="{StaticResource SecondaryText}" ToolTip="הצג בדיוק מה יישלח">הצג</Hyperlink></TextBlock></InlineUIContainer>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Opened by the share link until the user first shares: what sharing is, before anything is sent. -->
        <Popup x:Name="contributePopup" PlacementTarget="{Binding ElementName=scanFooter}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Width="360">
            <Border FlowDirection="RightToLeft" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1" CornerRadius="2"
                    Margin="6,0,6,4" Padding="14,12"
                    TextElement.Foreground="{StaticResource Text}"
                    TextElement.FontFamily="Segoe UI" TextElement.FontSize="12">
                <StackPanel>
                    <TextBlock Text="עזור לשפר את הדיוק של התוסף" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                        דיווח של ההכרעות והטעויות שמצאת מאפשר לשפר את הגרסה הבאה של התוסף.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,4">
                        מה נשלח: כמה מילים סביב כל שם, בלי ניקוד, וההכרעה שלך. לא המסמך, לא שמו ולא מי אתה.
                    </TextBlock>
                    <TextBlock Margin="0,0,0,10">
                        <Hyperlink Click="ContributeShow_Click" Foreground="{StaticResource Accent}">הצג בדיוק מה יישלח</Hyperlink>
                    </TextBlock>
                    <CheckBox x:Name="shareAutomatically" Content="מעכשיו, שתף אוטומטית בסיום כל סקירה"
                              VerticalContentAlignment="Center" Margin="0,0,0,12" Loaded="CheckBox_Loaded"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="שתף" Style="{StaticResource PrimaryButton}" Click="ContributePopupSend_Click"/>
                        <Button Content="לא עכשיו" Style="{StaticResource FlatButton}" Click="ContributePopupClose_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
