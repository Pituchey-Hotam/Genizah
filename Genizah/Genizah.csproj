  <!-- ONNX Runtime's props add its native DLL as a None item, which the ClickOnce manifest leaves
       out: make it Content, so an installed add-in has it too, not only bin\. -->
  <Target Name="PublishOnnxRuntimeNative" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_OnnxRuntimeNative Include="@(None)" Condition="'%(None.Link)' == 'onnxruntime.dll'" />
      <None Remove="@(_OnnxRuntimeNative)" />
      <Content Include="@(_OnnxRuntimeNative)" />
    </ItemGroup>
  </Target>
  <!-- The assembly's version attributes, from ../VERSION (see GenizahVersion). -->
  <Target Name="WriteVersionInfo" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_VersionAttribute Include="System.Reflection.AssemblyVersionAttribute"><_Parameter1>$(GenizahVersion).0</_Parameter1></_VersionAttribute>
      <_VersionAttribute Include="System.Reflection.AssemblyFileVersionAttribute"><_Parameter1>$(GenizahVersion).0</_Parameter1></_VersionAttribute>
      <_VersionAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute"><_Parameter1>$(GenizahVersion)</_Parameter1></_VersionAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#" AssemblyAttributes="@(_VersionAttribute)" OutputFile="$(IntermediateOutputPath)VersionInfo.g.cs">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
      <Output TaskParameter="OutputFile" ItemName="FileWrites" />
    </WriteCodeFragment>
  </Target>
