<Window x:Class="Genizah.CensorSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="הגדרות גניזה"
        Icon="/Genizah;component/Resources/Settings.ico"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Genizah;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Footer" Color="#FAF9F8"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Footer}"
                BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="ביטול" IsCancel="True"
                        Style="{StaticResource FlatButton}" Margin="0"/>
                <Button DockPanel.Dock="Right" Content="אישור" IsDefault="True" Click="Ok_Click"
                        Style="{StaticResource PrimaryButton}"/>
                <Border/>
            </DockPanel>
        </Border>

        <StackPanel Margin="20,16,20,18" Grid.IsSharedSizeScope="True">
            <TextBlock Foreground="{StaticResource SecondaryText}" Margin="0,0,0,14">
                בחר כיצד ייכתב כל שם כשהוא מצונזר.<LineBreak/>אפשר גם להקליד צורה משלך.
            </TextBlock>

            <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"
                    Padding="0,0,0,5" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Name"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="שם" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}"/>
                    <TextBlock Grid.Column="1" Text="ייכתב כ־" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryText}"/>
                </Grid>
            </Border>

            <ItemsControl x:Name="rows" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="Name" MinWidth="96"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="label" Text="{Binding DisplayName}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <ComboBox Grid.Column="1" Width="160" Height="26" IsEditable="True"
                                      VerticalContentAlignment="Center" FontSize="13"
                                      ItemsSource="{Binding Options}"
                                      Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.LabeledBy="{Binding ElementName=label}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,8,0,0">
                <Hyperlink Click="Defaults_Click" Foreground="{StaticResource Accent}">שחזר צורות ברירת מחדל</Hyperlink>
            </TextBlock>

            <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0"
                    Padding="0,12,0,0" Margin="0,14,0,0">
                <StackPanel>
                    <CheckBox x:Name="checkBeforePrinting" FontSize="13" VerticalContentAlignment="Center"
                              Content="בדוק את מצב הסקירה לפני הדפסה" Margin="0,0,0,10"
                              ToolTip="כאשר האפשרות כבויה, גניזה אינה בודקת או מציגה הודעות בעת הדפסה."/>
                    <CheckBox x:Name="checkForUpdates" FontSize="13" VerticalContentAlignment="Center"
                              Content="עדכן את גניזה אוטומטית"
                              ToolTip="בכל הפעלה של Word, בדוק אם יש גרסה חדשה והתקן אותה ברקע. היא תפעל מההפעלה הבאה."/>
                    <TextBlock x:Name="updateStatus" Foreground="{StaticResource SecondaryText}"
                               Margin="20,4,0,0" MaxWidth="320" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,12,0,0">
                        <Hyperlink Click="About_Click" Foreground="{StaticResource Accent}">על אודות התוסף</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
